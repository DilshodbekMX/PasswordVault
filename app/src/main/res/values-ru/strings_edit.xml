    <string name="edit_gen_title">Создать надёжный пароль</string>
    <string name="edit_gen_new">Новый пароль</string>
    <!-- The two kinds of password, a segmented button: random characters, or words. -->
    <string name="edit_gen_random">Случайный</string>
    <string name="edit_gen_words">Из слов</string>
    <string name="edit_gen_length">Длина</string>
    <string name="edit_gen_shorter">Короче</string>
    <string name="edit_gen_longer">Длиннее</string>
    <string name="edit_gen_upper">A–Z</string>
    <string name="edit_gen_lower">a–z</string>
    <string name="edit_gen_digits">0–9</string>
    <!-- Glossary 82; the symbols are kept exactly as they are. -->
    <string name="edit_gen_symbols">Специальные символы ! # $ % &amp; * + - = ? @ _</string>
    <!-- The characters are kept as they are; no-break spaces keep the group on one line. -->
    <string name="edit_gen_look_alike">Без похожих символов (I&#160;l&#160;1&#160;O&#160;0)</string>
    <string name="edit_gen_one_kind">Нужен хотя бы один вид символов.</string>
    <string name="edit_gen_word_count">Количество слов</string>
    <string name="edit_gen_fewer_words">Меньше слов</string>
    <string name="edit_gen_more_words">Больше слов</string>
    <string name="edit_gen_separator">Разделитель</string>
    <string name="edit_gen_separator_hyphen">Дефис</string>
    <string name="edit_gen_separator_dot">Точка</string>
    <string name="edit_gen_separator_underscore">Подчёркивание</string>
    <string name="edit_gen_separator_space">Пробел</string>
    <!-- Each word starts with a capital letter (glossary 79). -->
    <string name="edit_gen_capitalize">Заглавные буквы</string>
    <!-- One digit is added after one of the words. -->
    <string name="edit_gen_add_number">Добавить цифру</string>
    <string name="edit_gen_hint">Если сайт не принимает этот пароль, уменьшите число символов или отключите специальные символы.</string>
    <string name="edit_gen_use">Использовать этот пароль</string>
    <string name="edit_replace">Заменить текущий пароль?</string>
    <string name="edit_replace_yes">Заменить</string>

