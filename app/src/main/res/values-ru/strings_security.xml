<?xml version="1.0" encoding="utf-8"?>
<!-- Русский: the Security tab (build plan 6.4b; ux.md §5.16). Glossary (i18n.md §3): 91 «Проверка
     безопасности», 92 «повторно используемый пароль», 93 «ненадёжный пароль», 95 «Изменить пароль»,
     48 «мастер-пароль», 2 «аккаунт», 37 «Отменить». An account's name (%1$s) cannot be declined in
     Russian, so it follows «аккаунт» in quotes (i18n.md §4.4). The plural item one is also 21, 31…:
     every item works for those too. -->
<resources>

    <string name="security_title">Проверка безопасности</string>

    <string name="security_why_title">Почему это важно</string>
    <string name="security_why_text">Если с одного сайта утечёт ваш пароль, злоумышленники попробуют его в других ваших аккаунтах. Задайте каждому аккаунту свой пароль. Начните с электронной почты&#160;— тот, кто управляет вашей почтой, может сбросить остальные ваши пароли.</string>
    <string name="security_why_show">Развернуть «Почему это важно»</string>
    <string name="security_why_hide">Свернуть «Почему это важно»</string>

