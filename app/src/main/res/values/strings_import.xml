    <string name="import_file_kept">The file was kept. It is not protected, so delete it when you no longer need it.</string>
    <!-- When many imported accounts share a password. -->
    <string name="import_shared">Many of these accounts share a password. Open Security to fix them one by one.</string>
    <!-- Text button: opens the Security tab. -->
    <string name="import_open_security">Open Security</string>

    <!-- ===== A backup file (ux.md §5.21 "Backup file into an existing vault", §5.2) ===== -->

    <!-- Above the backup's master password field. -->
    <string name="import_backup_prompt">Type the master password you had when you made this backup.</string>
    <!-- Label of the backup's master password field. -->
    <string name="import_backup_password">Master password of the backup</string>
    <!-- Button: opens the backup with the password typed. -->
    <string name="import_backup_open">Open backup</string>
    <!-- Shown while the backup is opened (about a second), read by TalkBack. -->
    <string name="import_backup_opening">Opening…</string>
    <!-- Under the field: the password does not open the backup (ux.md §5.2). -->
    <string name="import_backup_wrong">This password does not open this backup. Try the master password you used when you made it.</string>
    <!-- Under the field: the password is wrong or the file is damaged (architecture.md §3.5). -->
    <string name="import_backup_wrong_or_damaged">This file may be damaged, or the password is wrong.</string>
    <!-- Under the field: not enough memory to open the backup (ux.md §5.2). -->
    <string name="import_backup_no_memory">Your phone does not have enough free memory to open the file. Close other apps and try again.</string>
    <!-- The opened backup. %1$d is how many accounts it has, %2$s the date it was made, formatted. -->
    <plurals name="import_backup_summary">
        <item quantity="one">%1$d account, backup made on %2$s.</item>
        <item quantity="other">%1$d accounts, backup made on %2$s.</item>
    </plurals>
    <!-- Under the summary: what adding does. -->
    <string name="import_backup_rules">Accounts that are already here are skipped. Nothing here is changed or replaced.</string>
    <!-- Button: adds the backup's accounts to the passwords here. -->
    <string name="import_backup_add">Add to my passwords</string>
    <!-- Shown while the accounts are added, read by TalkBack. -->
    <string name="import_backup_adding">Adding…</string>
    <!-- After adding. -->
    <plurals name="import_backup_added">
        <item quantity="one">%1$d account added.</item>
        <item quantity="other">%1$d accounts added.</item>
    </plurals>
    <!-- After adding: accounts of the backup that were already here. -->
    <plurals name="import_backup_skipped">
        <item quantity="one">%1$d was already here and was skipped.</item>
        <item quantity="other">%1$d were already here and were skipped.</item>
    </plurals>
    <!-- After adding: accounts added with "(from backup)" in their names. -->
    <plurals name="import_backup_renamed">
        <item quantity="one">%1$d was added with “(from backup)” in its name, because an account here has the same id and other content.</item>
        <item quantity="other">%1$d were added with “(from backup)” in their names, because accounts here have the same ids and other content.</item>
    </plurals>

    <!-- ===== Texts stored with imported accounts ===== -->

    <!-- The name of an imported account that has no name, no website and no username: "Untitled" and the
         date and time of the import. %1$s is the date and time, formatted for the language. This text is
         stored with the account. -->
    <string name="import_untitled">Untitled %1$s</string>
    <!-- The name of an imported account whose id is held by an account here with other content (formats.md
         §5.2): its own name, then "(from file)". %1$s is the name, for example "Gmail". Stored with the account. -->
    <string name="import_from_file">%1$s (from file)</string>
    <!-- The same for an account of a backup file (ux.md §5.21): "Gmail (from backup)". Stored with the account. -->
    <string name="import_from_backup">%1$s (from backup)</string>
</resources>
