<?xml version="1.0" encoding="utf-8"?>
<!-- The texts of the phone's fingerprint prompt that the lock manager builds (build plan 4.1; lock.md
     §9.2 rule 5). The lock's texts belong to strings_lock.xml, which is the lock screens package's
     (4.2) and is on its branch: the first three below are copies of the strings of that file, with
     the same names and texts, so that this branch builds; the last two are new. The merge of sub-wave
     4A moves the new ones into strings_lock.xml, under "The system's fingerprint prompt", and deletes
     this file. Every name starts with lock_. -->
<resources>

    <!-- Title of the phone's fingerprint prompt over the lock screen. The app's name is not
         translated (i18n.md §3). -->
    <string name="lock_prompt_unlock_title">Open PasswordVault</string>
    <!-- Title of the phone's fingerprint prompt that turns fingerprint unlock on (lock.md F9 step 6). -->
    <string name="lock_prompt_turn_on_title">Turn on fingerprint unlock</string>
    <!-- Button: the master-password screen instead (glossary 50). Also the fingerprint prompt's
         button over the lock screen when no PIN can be used. -->
    <string name="lock_use_master_password">Use master password</string>

    <!-- Title of the phone's fingerprint prompt after the master password was changed: one touch
         keeps fingerprint unlock working with the new master password (lock.md F8 step 7). Its
         button is "Not now". -->
    <string name="lock_prompt_keep_title">Keep fingerprint unlock</string>
    <!-- Title of the phone's fingerprint prompt that confirms the request for a new master password
         on a phone without a PIN (lock.md F11 step 3). Its button is "Cancel". -->
    <string name="lock_prompt_confirm_title">Confirm with your fingerprint</string>

</resources>
