<?xml version="1.0" encoding="utf-8"?>
<!-- Ўзбекча (кирилл): library strings overridden in Uzbek Cyrillic (i18n.md §1.4.6; build plan 6.3).
     appcompat, Compose and androidx.biometric ship values-uz and values-ru but no values-b+uz+Cyrl,
     so without this file their built-in texts show in English when the app is in Ўзбекча. An app
     resource with the same name and qualifier wins when resources are merged; tools:override marks
     each as a deliberate override of a library's private string (lint PrivateResource).

     The list: every string of `aapt2 dump resources` on the release APK (tools/gradle.sh
     :app:assembleRelease, at wave-6A-merged plus 6.3a) that is not one of the app's own names,
     minus appcompat's abc_* (its action bar, search view and menu shortcuts; the app draws no
     AppCompat widget) and androidx_startup (a metadata key, never shown). Each text is the
     library's own values-uz text converted by the rules of i18n.md §2.5 (UzbekCyrillicStrings) and
     read, so that Latin and Cyrillic readers hear the same words; the English is in the comment.
     Make the list again whenever one of these libraries changes version, and remove a name that
     no longer reaches the APK. Lint sees only the app's own default strings, so it would call each
     override an ExtraTranslation and an unused resource: tools:ignore says they are deliberate. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ExtraTranslation,UnusedResources">

    <!-- ===== androidx.biometric 1.4.0-alpha07: the fingerprint dialog it draws itself on Android 7 to 8.1 (API 24 to 27) and its errors. ===== -->
    <!-- Use password -->
    <string name="confirm_device_credential_password" tools:override="true">Паролдан фойдаланиш</string>
    <!-- More options button in the content view is clicked. -->
    <string name="content_view_more_options_button_clicked" tools:override="true">Экранда “Бошқа параметрлар” тугмаси босилган.</string>
    <!-- Unknown error -->
    <string name="default_error_msg" tools:override="true">Нотаниш хато</string>
    <!-- Fingerprint Authentication Dialog -->
    <string name="fingerprint_dialog_activity_label" tools:override="true">Бармоқ изи аутентификация ойнаси</string>
    <!-- Fingerprint icon -->
    <string name="fingerprint_dialog_icon_description" tools:override="true">Бармоқ изи белгиси</string>
    <!-- Touch the fingerprint sensor -->
    <string name="fingerprint_dialog_touch_sensor" tools:override="true">Бармоқ изи сканерига тегининг</string>
    <!-- Fingerprint hardware not available. -->
    <string name="fingerprint_error_hw_not_available" tools:override="true">Бармоқ изи сканери иш ҳолатида эмас.</string>
    <!-- This device does not have a fingerprint sensor -->
    <string name="fingerprint_error_hw_not_present" tools:override="true">Бу қурилмада бармоқ изи сканери йўқ</string>
    <!-- Too many attempts. Please try again later. -->
    <string name="fingerprint_error_lockout" tools:override="true">Жуда кўп уриниш амалга оширилди. Кейинроқ қайтадан урининг.</string>
    <!-- No fingerprints enrolled. -->
    <string name="fingerprint_error_no_fingerprints" tools:override="true">Ҳеч қандай бармоқ изи қайд қилинмаган.</string>
    <!-- Fingerprint operation canceled by user. -->
    <string name="fingerprint_error_user_canceled" tools:override="true">Бармоқ изи амали фойдаланувчи томонидан бекор қилинди</string>
    <!-- Not recognized -->
    <string name="fingerprint_not_recognized" tools:override="true">Аниқланмади</string>
    <!-- No PIN, pattern, or password set. -->
    <string name="generic_error_no_device_credential" tools:override="true">PIN код, график калит ёки парол созланмаган.</string>
    <!-- This device does not support PIN, pattern, or password. -->
    <string name="generic_error_no_keyguard" tools:override="true">Бу қурилмада PIN код, график калит ва парол ишламайди.</string>
    <!-- Authentication canceled by user. -->
    <string name="generic_error_user_canceled" tools:override="true">Аутентификация фойдаланувчи томонидан бекор қилинди</string>

