<?xml version="1.0" encoding="utf-8"?>
<!-- The helper app of tools/emu/window (build plan 3.12), from the window lab's helper
     (docs/lab/window-input-artifacts). Installed only on the private emulators, next to the app
     under test, by tools/emu/window/lib.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- So that the overlay can be drawn over other apps (granted with appops by the scripts). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Reads the saved-instance state of PasswordVault's activity, in the app's own process
         (state.sh). Android runs it only because both APKs are signed with the debug key. -->
    <instrumentation
        android:name=".StateProbe"
        android:label="saved-state probe (PasswordVault)"
        android:targetPackage="io.github.dilshodbekmx.passwordvault" />

    <!-- The same probe on this app's own control screen: the control of state.sh's method. -->
    <instrumentation
        android:name=".StateProbeSelf"
        android:label="saved-state probe (control)"
        android:targetPackage="io.github.dilshodbekmx.pvlab.window" />

    <application
        android:allowBackup="false"
        android:label="PV window lab">

        <!-- The control of every check: two platform text fields and a button with no protection
             at all. adb starts it, so it is exported. -->
        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Logs every fill and save request it gets, and never fills anything. Enabled with
             "settings put secure autofill_service io.github.dilshodbekmx.pvlab.window/.LabAutofillService". -->
        <service
            android:name=".LabAutofillService"
            android:exported="true"
            android:label="LabFill"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- An accessibility service that does not call itself an accessibility tool: the kind
             isAccessibilityDataSensitive and isSensitiveData keep out on Android 14 and newer. -->
        <service
            android:name=".LabA11yService"
            android:exported="true"
            android:label="LabA11y"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lab_a11y" />
        </service>

        <!-- The same service declared as an accessibility tool, as a screen reader is: what the
             app does not hide from anybody. -->
        <service
            android:name=".LabA11yToolService"
            android:exported="true"
            android:label="LabA11yTool"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lab_a11y_tool" />
        </service>

        <!-- Writes down what apps send to content capture (Android 10 and newer): made the device's
             temporary content capture service by capture.sh. A system API service, bound only
             with the permission below, which only the system holds. -->
        <service
            android:name=".LabCaptureService"
            android:exported="true"
            android:label="LabCapture"
            android:permission="android.permission.BIND_CONTENT_CAPTURE_SERVICE">
            <intent-filter>
                <action android:name="android.service.contentcapture.ContentCaptureService" />
            </intent-filter>
        </service>

        <!-- The scripts' commands (overlay, accessibility dump, clipboard): "am broadcast -n
             io.github.dilshodbekmx.pvlab.window/.LabCommandReceiver" with the extra "cmd". Exported so
             that adb can reach it, behind DUMP, which adb shell holds and other apps do not. -->
        <receiver
            android:name=".LabCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
