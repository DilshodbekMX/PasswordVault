<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- (c) exact alarms. API 31-32: SCHEDULE_EXACT_ALARM (special access, user-revocable).
         API 33+: USE_EXACT_ALARM (granted at install; Google Play restricts who may declare it). -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- (f) shortService foreground service. No type-specific permission exists for shortService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".LabApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PasswordVault">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads the clipboard when it gains window focus. Own task so that finishing it
             does not bring MainActivity back to the front. -->
        <activity
            android:name=".ProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="com.example.pvlab.clip.probe" />

        <!-- (b) (c) (d) alarm target. Not exported: only our own PendingIntent reaches it. -->
        <receiver
            android:name=".ClearReceiver"
            android:exported="false" />

        <!-- The "final" candidate. -->
        <receiver
            android:name=".ClipboardClearReceiver"
            android:exported="false" />

        <!-- (f) -->
        <service
            android:name=".ClearShortService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>
